{
  "name": "leaf-reader",
  "version": "0.1.16",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/copy-pdf-assets.mjs",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vinext dev",
    "build": "vinext build",
    "prebuild:mobile": "node scripts/copy-pdf-assets.mjs",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "preview:mobile": "vite preview --config vite.mobile.config.ts",
    "ios:sync": "npm run build:mobile && cap sync ios",
    "ios:open": "cap open ios",
    "ios:assets": "node scripts/generate-ios-assets.mjs",
    "verify:mobile": "tsx scripts/verify-mobile.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app components/reader.tsx components/zoom-reader.tsx components/theme-provider.tsx lib mobile scripts capacitor.config.ts vite.mobile.config.ts",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/status-bar": "8.0.3",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "dompurify": "^3.4.14",
    "embla-carousel-react": "8.5.2",
    "epubjs": "^0.3.93",
    "idb": "^8.0.3",
    "input-otp": "1.4.2",
    "jszip": "^3.10.1",
    "lucide-react": "1.31.0",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260801.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "0.35.2",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.120.0"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "^0.8.15"
    }
  },
  "type": "module"
}
